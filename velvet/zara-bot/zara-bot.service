[Unit]
Description=Zara Lsd · bot Discord AI di OurVelvet (solo server di doc, risponde a /zara e menzioni)
After=network-online.target ourvelvet.service
Wants=network-online.target

[Service]
User=zara
Group=zara
SupplementaryGroups=agikey
WorkingDirectory=/opt/zara-bot
EnvironmentFile=/etc/zara/bot.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/zara-bot/zara.js
Restart=on-failure
RestartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
