# Æsir DSN gate configuration.
# $DSN è ufficiale su ENTRAMBE le catene (decisione in docs/token.md).
#   DSN_CHAIN=both     -> conta Polygon e Solana (default)
#   DSN_CHAIN=polygon  -> solo ERC-20 su Polygon PoS
#   DSN_CHAIN=solana   -> solo Token-2022 su Solana
# Vuoto o valore sconosciuto = gate chiuso (richieste non umane negate).
DSN_CHAIN=both

# --- Polygon PoS (chain id 137), ERC-20, 18 decimali ---
DSN_CONTRACT=0xfc90516a1f736FaC557e09D8853dB80dA192c296
DSN_CHAIN_ID=137
DSN_POLYGON_DECIMALS=18
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACK=https://polygon.drpc.org

# --- Solana, Token-2022, 6 decimali ---
DSN_SOLANA_MINT=35w74RT77BPSYNpmzpvxmR9wu2ihpgzubKy4bkGHR3F4
DSN_SOLANA_DECIMALS=6
DSN_SOLANA_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
# Gli RPC pubblici limitano o rifiutano getTokenAccountsByOwner: il gate ripiega
# sul conto associato (ATA) letto con getAccountInfo (non indicizzata). Per uso serio mettere qui il proprio RPC / nodo z-xSOLANA.
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK=https://solana-rpc.publicnode.com

# --- SOGLIE (MODIFICABILI) — in token interi, scalate dai decimali di ogni catena ---
# Proporzione di supply uguale: Polygon 10^9 token, Solana 10^12 token (x1000).
DSN_POLYGON_MIN_TOKENS=1
DSN_POLYGON_HIGH_TOKENS=10
DSN_SOLANA_MIN_TOKENS=1000
DSN_SOLANA_HIGH_TOKENS=10000

# --- VELVET ($OV) — asset OPZIONALE, SPENTO di default ---
# Token community su Solana (Token-2022, 6 decimali, supply 10^9). Nessun rendimento,
# nessuna promessa finanziaria. Se VELVET_ENABLED=1, chi lo detiene sopra soglia passa
# il gate come chi detiene $DSN. Soglie MODIFICABILI (0,01% e 0,1% della supply).
VELVET_ENABLED=0
VELVET_MINT=2EN6Y1zM4yyt41gE2muzdJSAgRCAZiXqnmkgpbrspump
VELVET_DECIMALS=6
VELVET_TOKEN_PROGRAM=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
VELVET_MIN_TOKENS=100000
VELVET_HIGH_TOKENS=1000000

# --- Limiti orari passati al policy engine ---
DSN_HOURLY_BASE=500000000
DSN_HOURLY_BOOSTED=5000000000

DSN_PORTAL_URL=https://x-zdos.it/dsn
