# Z-X SOLANA Store — beta.x-zdos.it (vhost dedicato, non modifica gli altri server)
# Accesso riservato (HTTP Basic) + noindex. Non pubblicare in chiaro.

server {
    listen 80;
    listen [::]:80;
    server_name beta.x-zdos.it;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/zxstore-beta;
        default_type text/plain;
        allow all;
        auth_basic off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name beta.x-zdos.it;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/beta.x-zdos.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/beta.x-zdos.it/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/zxstore-beta;
    index index.html;

    auth_basic "Z-X SOLANA Store · accesso riservato";
    auth_basic_user_file /etc/nginx/htpasswd-beta;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    add_header Cache-Control "no-store" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/zxstore-beta;
        default_type text/plain;
        allow all;
        auth_basic off;
    }

    location = /robots.txt {
        auth_basic off;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header Cache-Control "no-store" always;
        try_files /robots.txt =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
        client_max_body_size 32k;
    }

    location ~* ^/(server|career|\.venv|node_modules|\.git|_deploy)(/|$) {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
